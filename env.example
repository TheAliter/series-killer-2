# =============================================================================
# Nuxt (.env.local) — copy from env.local.example or merge these NUXT_PUBLIC_*
# =============================================================================
# Convex deployment URLs: Convex dashboard → your deployment → Settings.
NUXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# HTTP routes for Better Auth live on the .site host (not .cloud).
NUXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
# Origin users open in the browser (local dev or Cloudflare Pages URL).
NUXT_PUBLIC_SITE_URL=https://your-pages-domain.pages.dev

# =============================================================================
# Convex deployment env — set via CLI or Dashboard → Settings → Environment
# =============================================================================
# Secret for Better Auth (generate e.g. openssl rand -base64 32, or any long random string).
#   npx convex env set BETTER_AUTH_SECRET "your-secret-here"
#
# Resend API key used to deliver password reset emails.
#   npx convex env set RESEND_API_KEY "re_xxxxxxxxx"
#
# Optional sender address (defaults to onboarding@resend.dev when unset).
#   npx convex env set RESEND_FROM "onboarding@resend.dev"
#
# Must match the real browser origin (per environment): local http://localhost:3000 or prod Pages URL.
#   npx convex env set SITE_URL "http://localhost:3000"
#
# Public .site URL of this Convex deployment (used as Better Auth baseURL /api/auth).
#   npx convex env set CONVEX_SITE_URL "https://your-deployment.convex.site"
#
# Optional: JSON JWKS string for auth token verification. This repo passes it when set
# (see convex/auth.config.ts). If unset, getAuthConfigProvider receives {} — same pattern as
# https://labs.convex.dev/better-auth — and is enough for typical email/password flows.
#   npx convex env set JWKS '{"keys":[...]}'
#
# Optional: library import mutations (scripts/migrate-from-supabase.mjs).
#   npx convex env set MIGRATION_SECRET "your-migration-secret"

# =============================================================================
# Cloudflare Pages (build-time environment variables)
# =============================================================================
# Framework preset: Nuxt. Build command: npm run build
# Build output directory: dist  (verified for nitro preset cloudflare_pages / Nuxt 4.4)
#
# Add the same three NUXT_PUBLIC_* variables as production values. After the first deploy,
# set Convex SITE_URL to your real Pages hostname (e.g. https://xxx.pages.dev or custom domain).

# =============================================================================
# Optional: Supabase migration script only (not used by the app at runtime)
# =============================================================================
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=server-only
# CONVEX_URL=https://your-deployment.convex.cloud
# MIGRATION_SECRET=must-match-convex-env
#
# Optional controls:
# SOURCE_SUPABASE_USER_ID=uuid-filter-for-single-user
# MIGRATION_DRY_RUN=false
# MIGRATION_SKIP_PASSWORD_RESET=false
# MIGRATION_RESET_REDIRECT_TO=https://your-app/reset-password

# Cloudflare Pages: build command `npm run build`, output directory `dist`
# (Nitro preset cloudflare_pages). Set the NUXT_PUBLIC_* vars in the Pages project.

# Nuxt (public — safe in browser / Cloudflare Pages)
NUXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NUXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
NUXT_PUBLIC_SITE_URL=https://your-pages-domain.pages.dev

# Convex dashboard / `npx convex dev` (not prefixed with NUXT_)
# BETTER_AUTH_SECRET=generate-a-long-random-string
# SITE_URL=https://your-pages-domain.pages.dev
# CONVEX_SITE_URL=https://your-deployment.convex.site
# MIGRATION_SECRET=optional-secret-for-import-mutations

# Optional: read-only Supabase export (migration script only)
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=server-only

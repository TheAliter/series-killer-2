# Copy to .env.local for local Nuxt dev (gitignored).
# Run `npx convex dev` in another terminal so Convex types and backend stay in sync.

NUXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# Required in the browser: Better Auth HTTP routes are served from the .site URL.
NUXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Also set on the Convex deployment (Dashboard or CLI), not only here:
#   SITE_URL=http://localhost:3000
#   CONVEX_SITE_URL=https://your-deployment.convex.site
#   BETTER_AUTH_SECRET=<long random secret>
#   RESEND_API_KEY=re_xxxxxxxxx
# Optional sender address (defaults to onboarding@resend.dev):
#   RESEND_FROM=onboarding@resend.dev
#
# Optional one-time migration env (for `npm run migrate:supabase`):
#   SUPABASE_URL=https://xxx.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY=server-only
#   CONVEX_URL=https://your-deployment.convex.cloud
#   MIGRATION_SECRET=<same value as Convex env>
#   SOURCE_SUPABASE_USER_ID=<optional single-user filter>
#   MIGRATION_DRY_RUN=false
#   MIGRATION_SKIP_PASSWORD_RESET=false
#   MIGRATION_RESET_REDIRECT_TO=http://localhost:3000/reset-password
